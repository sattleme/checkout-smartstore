<Project>
  <!--
    Every project of this repository: Smartstore 6.4's framework (net10.0), the same compiler and
    the same rules, warnings as errors.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <Features>strict</Features>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- XML documentation everywhere: the build reports unused usings (IDE0005) only with it. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>sattle.me</Authors>
    <Company>sattle.me</Company>
    <Copyright>Copyright (c) 2026 Swiss Bitcoin Pay Sàrl</Copyright>
    <Product>sattle.me for Smartstore</Product>
    <Version>1.0.0</Version>
    <RepositoryUrl>https://github.com/sattleme/checkout-smartstore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Packages: one version each (Directory.Packages.props), every restore from the lockfiles. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- In CI (and scripts/check.sh), a restore that would change a lockfile fails. -->
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- NuGet's audit of this repository's own packages: a vulnerable one fails the build. -->
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>

  <!--
    Smartstore's assemblies, those of its release 6.4.0 (scripts/smartstore.sh fetches them, checked
    against the archive's SHA-256): the module is compiled against them, never ships them. Another
    place: the environment variable SMARTSTORE_DIR, or -p:SmartstoreDir=….
  -->
  <PropertyGroup>
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <SmartstoreDir Condition="'$(SmartstoreDir)' == ''">$(SMARTSTORE_DIR)</SmartstoreDir>
    <SmartstoreDir Condition="'$(SmartstoreDir)' == ''">$(RepositoryRoot).smartstore</SmartstoreDir>
    <SmartstoreDir>$([MSBuild]::EnsureTrailingSlash('$(SmartstoreDir)'))</SmartstoreDir>
  </PropertyGroup>
</Project>
