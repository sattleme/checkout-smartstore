@model int
<div class="sattleme-payment-info">
    <p>@T("Plugins.Sattleme.Bitcoin.PaymentMethodDescription")</p>
    @* One minute in the singular, more in the plural (Smartstore's resources have no plural forms). *@
    <p class="mb-0">@T(Model == 1 ? "Plugins.Sattleme.Bitcoin.PaymentInfo.NextOneMinute" : "Plugins.Sattleme.Bitcoin.PaymentInfo.Next", Model)</p>
</div>
